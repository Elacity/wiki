{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elacity/wiki/main/metadata/schemas/subscription/v1.0/schema.json",
  "title": "Subscription Metadata",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "schema": {
      "const": "https://raw.githubusercontent.com/Elacity/wiki/main/metadata/schemas/subscription/v1.0/schema.json"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "object",
      "properties": {
        "subscriber": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "subscriber",
        "expiresAt"
      ],
      "additionalProperties": true
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trait_type": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "trait_type",
          "value"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "version",
    "schema",
    "name",
    "description",
    "image",
    "properties"
  ],
  "additionalProperties": true
}
